/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "linkedout-pipelines",
	"main": "src/index.tsx",
	"compatibility_date": "2025-12-02",
	"assets": {
		"binding": "ASSETS",
		"directory": "./public",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "AUTH_TOKENS",
			"id": "a4d40f72a26f4f6792a6f4bc8038a6b2"
		},
		{
			"binding": "MAP_CACHE",
			"id": "c44f5527672c42729aa08697c2c2307e"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "linkedout-db",
			"database_id": "40b9890c-3dea-4165-aa87-a58355de955e"
		}
	],
	"pipelines": [
		{
			"binding": "CLICK_STREAM",
			"pipeline": "f87b847eaee04aef95159ac8aace0219"
		}
	],
	"vars": {
		"CATALOG_URI": "https://catalog.cloudflarestorage.com/51e28e9a83197a9f12a2e39f9477ba4e/linkedout-data-catalog",
		"WAREHOUSE_NAME": "51e28e9a83197a9f12a2e39f9477ba4e_linkedout-data-catalog",
		"ACCOUNT_ID": "51e28e9a83197a9f12a2e39f9477ba4e"
	}
}
