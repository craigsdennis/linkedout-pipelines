/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "linkedout-pipelines",
	"main": "src/index.tsx",
	"compatibility_date": "2025-12-02",
	"assets": {
		"binding": "ASSETS",
		"directory": "./public",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "LINKS",
			"id": "5a77ea007d054a48921f86528e34ee10"
		},
		{
			"binding": "USERS",
			"id": "bdeb64c984974283acdabf39461c5e12"
		},
		{
			"binding": "AUTH_TOKENS",
			"id": "a4d40f72a26f4f6792a6f4bc8038a6b2"
		}
	],
	"pipelines": [
		{
			"binding": "CLICK_STREAM",
			"pipeline": "5c997851dcbf4541b83bdce392e6bf22"
		}
	],
	"vars": {
		"CATALOG_URI": "https://catalog.cloudflarestorage.com/51e28e9a83197a9f12a2e39f9477ba4e/linkedout-data-catalog",
		"WAREHOUSE_NAME": "51e28e9a83197a9f12a2e39f9477ba4e_linkedout-data-catalog",
		"ACCOUNT_ID": "51e28e9a83197a9f12a2e39f9477ba4e"
	}
}
